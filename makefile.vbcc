# Build pfs3aio with vbcc, one binary per tier in tiers.mk.
#
#   make -f makefile.vbcc                      # its builds into dist-vbcc/
#   make -f makefile.vbcc OUTDIR=somewhere
#
# Separate from makefile.gcc because vbcc shares no flags, no libraries and no
# assembler with gcc. See TOOLCHAINS.md, "vbcc".

SHELL := /bin/bash

VBCC ?= /opt/vbcc
VBCC_NDK ?= $(VBCC)/NDK/Include_H
OUTDIR ?= dist-vbcc

# vc shells out to vbccm68k by bare name, so its bin/ has to be on PATH.
VC = VBCC=$(VBCC) PATH=$(VBCC)/bin:$$PATH $(VBCC)/bin/vc
VASM = $(VBCC)/bin/vasmm68k_std
VLINK = $(VBCC)/bin/vlink

# Linked with vlink rather than vc, to force -Rstd: vc's aos68k config appends
# -Rshort, whose HUNK_DREL32 the ROM builder cannot parse. See TOOLCHAINS.md,
# "Linking".
VLFLAGS = -bamigahunk -x -Bstatic -Cvbcc -nostdlib -mrel -s -Rstd \
	-L$(VBCC)/targets/m68k-amigaos/lib

# vbcc emits no bitfield, MOVEP or 64-bit mul/div at any -cpu setting, so its
# tiers are safe on 68060 as they stand. Verified in TOOLCHAINS.md.
include tiers.mk

# Tiers vbcc is excluded from, see TIER_SKIP_<tier> in tiers.mk. Applied here
# rather than passed in, so a direct "make -f makefile.vbcc" builds the same
# set that GNUmakefile asks for.
TIERS := $(foreach t,$(TIERS),$(if $(filter vbcc,$(TIER_SKIP_$(t))),,$(t)))

include version.mk

# -fastcall passes arguments in registers. It @-prefixes every C symbol, which
# is why vbcc_compat.c, vbcc_fastcall.s and ASMLINKAGE exist. See TOOLCHAINS.md,
# "-fastcall".

# vc re-shells its command line and strips one level of quoting, so string
# defines need an extra level. See TOOLCHAINS.md, "Telling the variants apart".
NOWDATE := \\\"$(shell date "+%-d.%-m.%Y")\\\"
NOWTIME := \\\"$(shell date "+%T")\\\"

DEFS = -DMIN_LIB_VERSION=33 -DKSWRAPPER=1 \
	-DSCSIDIRECT=1 -DNSD=1 -DTD64=1 -DTRACKDISK=1 \
	-DEXTRAPACKETS=1 -DSIZEFIELD -DDELDIR=1 \
	-DMULTIUSER=0 -DPROTECTION=0 -DVERSION23=1 -DROLLOVER=1 \
	-DLIMIT_MAXTRANSFER=0x20000 -DUNSAFEQUIT=1 \
	-DREVDATE=$(NOWDATE) -DREVTIME=$(NOWTIME) \
	-DDETECTDEBUG=0

# Optimisation. -O1 is the smallest that works; -sc and -O4 both force 16-bit
# PC-relative calls that cannot reach across this code section. Measured
# variants in TOOLCHAINS.md, "Flags".
VBCC_OPT ?= -O1

VCFLAGS = +aos68k $(VBCC_OPT) -fastcall -DPFS_FASTCALL \
	-I. -I$(VBCC_NDK) $(DEFS) $(EXTRA_CFLAGS)

# Objects depend on the flags they were built with, so changing VBCC_OPT or
# EXTRA_CFLAGS forces a rebuild instead of silently leaving stale objects in
# place. REVDATE/REVTIME are deliberately not part of the stamp; they change
# every second and would rebuild everything on every run.
FLAGSTAMP = $(OUTDIR)/.buildflags
$(shell mkdir -p $(OUTDIR); \
	echo "$(VBCC_OPT) $(EXTRA_CFLAGS)" > $(OUTDIR)/.buildflags.new; \
	cmp -s $(OUTDIR)/.buildflags.new $(OUTDIR)/.buildflags \
		|| mv $(OUTDIR)/.buildflags.new $(OUTDIR)/.buildflags; \
	rm -f $(OUTDIR)/.buildflags.new)
VCLIBS = -lvc -lamiga

# Same set as makefile.gcc, plus vbcc_compat for the runtime bits vbcc lacks.
CSRC = boot init assroutines messages volume lock dostohandlerinterface anodes \
	directory lru disk update allocation CheckAccess diskchange resethandler \
	kswrapper format fsresource vbcc_compat

# startup must come first (its first instruction is the entry point) and end
# last (it marks the end of the resident module).
# vbcc_fastcall.s forwards the @-prefixed divide helpers, which only the 000
# build needs; above it divu.l/divs.l are hardware instructions. Linking it
# there anyway would drag _divu and _divs in from vc.lib for nothing, about 200
# bytes.
OBJ_ORDER_000 = startup $(CSRC) vbcc_fastcall end
OBJ_ORDER_020 = startup $(CSRC) end
OBJ_ORDER_000l = $(OBJ_ORDER_000)
OBJ_ORDER_020l = $(OBJ_ORDER_020)
OBJ_ORDER_030 = startup $(CSRC) end
OBJ_ORDER_040 = startup $(CSRC) end
OBJ_ORDER_060 = startup $(CSRC) end

.PHONY: all asm $(addprefix asm-,$(TIERS)) clean check help

all: check $(foreach t,$(TIERS),$(OUTDIR)/$(t)/pfs3aio)
	@printf "\n%-10s" tier; for t in $(TIERS); do printf " %8s" $$t; done; echo
	@printf "%-10s" vbcc; \
		for t in $(TIERS); do printf " %8s" $$(stat -c%s $(OUTDIR)/$$t/pfs3aio); done; echo

help:
	@echo "make -f makefile.vbcc [OUTDIR=dir] [VBCC=/opt/vbcc]"
	@echo "  all    Build $(TIERS) into \$$(OUTDIR)/<tier>/pfs3aio"
	@echo "  asm    Emit assembly for the instruction audit into \$$(OUTDIR)/asm/"
	@echo "  clean  Remove \$$(OUTDIR)"
	@echo "Knobs: OUTDIR= VBCC= VBCC_OPT='$(VBCC_OPT)' EXTRA_CFLAGS="

check:
	@test -x $(VBCC)/bin/vc || { echo "ERROR: no vbcc at $(VBCC)"; exit 1; }
	@test -d $(VBCC_NDK) || { echo "ERROR: no NDK headers at $(VBCC_NDK)"; exit 1; }

define TIER_RULES
$(OUTDIR)/$(1)/pfs3aio: $$(addprefix $(OUTDIR)/obj/$(1)/,$$(addsuffix .o,$$(OBJ_ORDER_$(1))))
	@mkdir -p $$(@D)
	$$(VLINK) $$(VLFLAGS) $$^ $$(VCLIBS) -o $$@

$(OUTDIR)/obj/$(1)/boot.o: $$(ORIGINSTAMP)

$(OUTDIR)/obj/$(1)/%.o: %.c $$(FLAGSTAMP)
	@mkdir -p $$(@D)
	$$(VC) $$(VCFLAGS) -cpu=$$(TIER_VBCPU_$(1)) -DLARGE_FILE_SIZE=$$(TIER_LARGE_$(1)) $$(TIER_TAG_$(1)) -c -o $$@ $$<

# startup.s and end.s are GNU-as sources with Motorola pseudo-ops mixed in and
# GNU numeric local labels; vbcc-preasm.py converts both for vasm, and
# vbcc-inc/ supplies the handful of exec LVOs in place of the NDK's
# Motorola-syntax exec_lib.i.
$(OUTDIR)/obj/$(1)/%.o: %.s $$(FLAGSTAMP) vbcc-preasm.py vbcc-inc/exec/exec_lib.i
	@mkdir -p $$(@D)
	cpp -Ivbcc-inc -P $$< | python3 vbcc-preasm.py > $$(@:.o=.s)
	$$(VASM) -Fhunk -quiet -nowarn=62 -o $$@ $$(@:.o=.s)
endef

# Assembly for the instruction audit, same flags as the objects.
ASM_SRC = $(filter-out vbcc_fastcall,$(CSRC))

define ASM_RULES
$(OUTDIR)/asm/$(1)/%.s: %.c
	@mkdir -p $$(@D)
	$$(VC) $$(VCFLAGS) -cpu=$$(TIER_VBCPU_$(1)) -DLARGE_FILE_SIZE=$$(TIER_LARGE_$(1)) $$(TIER_TAG_$(1)) -S -o $$@ $$<
asm-$(1): $$(addprefix $(OUTDIR)/asm/$(1)/,$$(addsuffix .s,$$(ASM_SRC)))
endef

$(foreach t,$(TIERS),$(eval $(call ASM_RULES,$(t))))

asm: check $(addprefix asm-,$(TIERS))

$(foreach t,$(TIERS),$(eval $(call TIER_RULES,$(t))))

clean:
	rm -rf $(OUTDIR)
